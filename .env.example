# Скопируйте этот файл в .env и подставьте свои значения.
# Значения есть в Supabase: Project Settings -> API Keys.

# URL проекта (без /rest/v1/)
VITE_SUPABASE_URL=https://ВАШ-ПРОЕКТ.supabase.co

# ПУБЛИЧНЫЙ ключ: Publishable key (sb_publishable_...) или legacy anon key (JWT с role=anon).
# Его безопасно использовать в браузере — доступ к данным ограничивает RLS.
VITE_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXX

# ВНИМАНИЕ: сюда НИКОГДА не попадает secret / service_role ключ.
# Такой ключ обходит RLS и даёт полный доступ к базе — его место только на сервере.
